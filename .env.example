# ───────────────────────────────────────────────────────────────────────────
# Casa Paella CRM — environment variables
# Copy to .env (dev) or .env.production (deploy) and fill in.
# ───────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Random 32+ char string. Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
AUTH_SECRET=change-me-in-production-please-this-is-not-secure

# ── Database (Hostinger MySQL) ────────────────────────────────────────────
# Use the credentials from hPanel → Databases → MySQL.
# IMPORTANT: use 127.0.0.1 if MySQL is on the same host (NOT localhost —
# Hostinger's resolver may return ::1 and break the IPv4 grant).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/crm_casa_paella

# ── WhatsApp provider ─────────────────────────────────────────────────────
# 'baileys' = free, QR scan, dev/MVP. 'meta' = official, paid, prod.
WHATSAPP_PROVIDER=baileys

# Baileys (dev/MVP) — session is persisted in ./auth_artifacts/baileys/
# First run: open /whatsapp page in the dashboard, scan QR with the business
# phone (+57 313 8818822 or whichever number the client wants to use).
BAILEYS_SESSION_DIR=./auth_artifacts/baileys

# Meta Cloud API (prod) — apply at developers.facebook.com
# Once Meta approves the WhatsApp Business account + templates, fill these:
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
# Webhook verify token — random string you also paste in Meta dashboard
META_WA_WEBHOOK_VERIFY_TOKEN=

# ── Restaurant config ─────────────────────────────────────────────────────
RESTAURANT_NAME=Casa Paella
RESTAURANT_PHONE=+573138818822
RESTAURANT_TIMEZONE=America/Bogota
DEFAULT_COUNTRY_CODE=+57

# ── Auth seed (first admin) ───────────────────────────────────────────────
# On first run, this email gets a staff account with password 'admin1234'
# (printed once in the server log). Change immediately.
SEED_ADMIN_EMAIL=admin@casapaella.com.co
