# Use legacy peer deps by default.
# Reason: @whiskeysockets/baileys@6.x has `peerOptional audio-decode@^2.1.3`,
# but we want the latest audio-decode. Without --legacy-peer-deps, npm
# refuses to install with ERESOLVE. This is safe because audio-decode's
# public API is backward-compatible.
legacy-peer-deps=true
