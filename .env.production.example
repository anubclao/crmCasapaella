# ═══════════════════════════════════════════════════════════════════════
# Casa Paella CRM — Hostinger production .env
# ═══════════════════════════════════════════════════════════════════════
# Rename to `.env.production` after filling in your real values.
# In hPanel Node.js App → "Environment variables" you can paste the
# same KEY=VALUE lines one per row, or upload this file to the
# application root and set the working directory accordingly.
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=production

# App public URL (no trailing slash). Should match the domain you bind
# in hPanel → Domains.
APP_URL=https://crm.casapaella.com.co

# 32+ char random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=VnVwBzGfYZh31WCEdONOuQxa1wIvElPj7SOfCdVji60=

# ── Database (from hPanel → Databases → MySQL) ────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# - On Hostinger, the DB host is usually '127.0.0.1' (NOT 'localhost')
#   so the IPv4 grant is used.
# - If Hostinger gives you a remote hostname, use that and SSL params
#   in the URL.
DATABASE_URL=mysql://u123456_admin:STRONG_PASSWORD@127.0.0.1:3306/u123456_crmcasapaella

# ── WhatsApp provider ────────────────────────────────────────────────
# 'baileys' for the MVP (free, QR scan). 'meta' for the official prod
# channel (paid, requires Meta-approved templates).
WHATSAPP_PROVIDER=baileys
BAILEYS_SESSION_DIR=./auth_artifacts/baileys

# Meta Cloud API — only required if WHATSAPP_PROVIDER=meta
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=

# ── Restaurant ────────────────────────────────────────────────────────
RESTAURANT_NAME=Casa Paella
RESTAURANT_PHONE=+573138818822
RESTAURANT_TIMEZONE=America/Bogota
DEFAULT_COUNTRY_CODE=+57

# ── Seed admin (first boot only) ─────────────────────────────────────
# Auto-created on first request to the app. CHANGE THE PASSWORD
# IMMEDIATELY via /settings or /users.
SEED_ADMIN_EMAIL=admin@casapaella.com.co
